# ── Docker Compose Local — Variables de entorno ───────────────
# Copiar a .env.local y completar con los valores reales.
# Uso: docker compose -f docker-compose.local.yml up -d

# ── Database principal ─────────────────────────────────────────
DATABASE_URL=postgresql://dbcontrol:changeme@localhost:5432/dbcontrol

# ── Server ─────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000
CORS_ORIGIN=http://localhost:5173

# Header CSP de nginx. Dejar report-only hasta revisar violaciones en consola;
# el único otro valor admitido activa enforcement: Content-Security-Policy.
CSP_HEADER_NAME=Content-Security-Policy-Report-Only

# Better Auth: límite por IP para requests POST (una réplica de API).
AUTH_RATE_WINDOW_MS=60000
AUTH_RATE_MAX=10
AUTH_RATE_MAX_KEYS=10000
AUTH_RATE_SWEEP_INTERVAL_MS=60000

# ── Cloudflare R2 ──────────────────────────────────────────────
R2_ACCOUNT_ID=<your-cloudflare-account-id>
R2_ACCESS_KEY_ID=<your-r2-access-key-id>
R2_SECRET_ACCESS_KEY=<your-r2-secret-access-key>
R2_BUCKET_NAME=<bucket-name>
R2_PUBLIC_BASE_URL=https://<your-r2-public-url>/

# ── Vite (runtime para web container, build-time para dev local) ─
# En docker-compose.local.yml (dev): Vite lee import.meta.env directo
# En docker-compose.yml (production): entrypoint.sh inyecta en config.js
VITE_API_URL=http://localhost:3000


# ── Encryption de passwords (AES-256-GCM) ─────────────────────
# Debe contener exactamente 64 caracteres hexadecimales (32 bytes).
# Generar con: openssl rand -hex 32
ENCRYPTION_KEY=<64-hex-characters-generated-with-openssl-rand-hex-32>

# ── Better Auth ────────────────────────────────────────────────
BETTER_AUTH_SECRET=<random-32-char-secret>
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_ADMIN_EMAIL=admin@vaultly.local
BETTER_AUTH_ADMIN_PASSWORD=<min-8-chars>
