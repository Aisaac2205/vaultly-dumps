# App & Server
NODE_ENV=development
PORT=3000
CORS_ORIGIN=http://localhost:5173
VITE_API_URL=http://localhost:3000

# Security (CSP & AES-256-GCM)
CSP_HEADER_NAME=Content-Security-Policy-Report-Only
# Generate with: openssl rand -hex 32 (must be 64 hex characters)
ENCRYPTION_KEY=<64-hex-characters>

# Database (PostgreSQL)
DB_NAME=vaultly
DB_USER=vaultly
DB_PASSWORD=<postgres-password>
# Use 'db' for Docker network, 'localhost' for local pnpm dev
DATABASE_URL=postgresql://vaultly:<postgres-password>@db:5432/vaultly

# Auth (Better Auth)
BETTER_AUTH_SECRET=<random-32-char-secret>
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_ADMIN_EMAIL=admin@vaultly.local
BETTER_AUTH_ADMIN_PASSWORD=<min-8-chars>

# Auth Rate Limiting
AUTH_RATE_WINDOW_MS=60000
AUTH_RATE_MAX=10
AUTH_RATE_MAX_KEYS=10000
AUTH_RATE_SWEEP_INTERVAL_MS=60000

# Storage (Cloudflare R2)
R2_ACCOUNT_ID=<your-cloudflare-account-id>
R2_ACCESS_KEY_ID=<your-r2-access-key-id>
R2_SECRET_ACCESS_KEY=<your-r2-secret-access-key>
R2_BUCKET_NAME=<bucket-name>
R2_PUBLIC_BASE_URL=https://<your-r2-public-url>/