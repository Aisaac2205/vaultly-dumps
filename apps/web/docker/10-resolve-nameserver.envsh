#!/bin/sh
# Sourced (not exec'd — note the .envsh suffix) by the official nginx
# entrypoint before its 20-envsubst-on-templates.sh step, so the export
# below is visible when that step renders templates/default.conf.template.
#
# We can't hardcode a DNS server IP for the `resolver` directive: it would
# be Docker Compose's embedded DNS (127.0.0.11) in one environment and
# whatever Railway wires up in another, and nginx's `resolver` directive
# has no built-in "use /etc/resolv.conf" mode. Reading the container's own
# resolv.conf at boot works on both without guessing.
set -eu

NGINX_RESOLVER=$(awk '/^nameserver/{print $2; exit}' /etc/resolv.conf)

if [ -z "${NGINX_RESOLVER}" ]; then
    echo "10-resolve-nameserver.envsh: no nameserver found in /etc/resolv.conf" >&2
    exit 1
fi

export NGINX_RESOLVER
